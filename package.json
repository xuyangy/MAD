{
  "name": "mad",
  "version": "1.0.0",
  "description": "MAD — multi-agent debate code review for OpenCode: several models review a change, contested findings are debated, and a judge checks each against the code.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "adapters/opencode/entry.ts",
  "exports": {
    ".": "./adapters/opencode/entry.ts",
    "./server": "./adapters/opencode/entry.ts",
    "./core": "./core/run/review.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun run scripts/lint-dependency-direction.ts && bun run scripts/lint-material-spans.ts",
    "test": "bun test",
    "clustering-rates": "bun run scripts/clustering-rates.ts",
    "cross-arm-rates": "bun run scripts/cross-arm-rates.ts",
    "plugin-budget-default": "bun run scripts/plugin-budget-default.ts",
    "live-check": "bun run scripts/live-check.ts",
    "v8-capture": "bun run scripts/v8-capture.ts",
    "ablation": "bun run scripts/ablation.ts",
    "materialize-change": "bun run scripts/materialize-labelled-change.ts",
    "eval-read": "bun run scripts/eval-read.ts",
    "paired": "bun run scripts/paired.ts",
    "adversarial": "bun run scripts/adversarial.ts",
    "adversarial-probe": "bun run scripts/adversarial-probe.ts",
    "accounting-probe": "bun run scripts/accounting-probe.ts",
    "oauth-prepare": "bun run scripts/oauth-prepare.ts",
    "oauth-probe": "bun run scripts/oauth-probe.ts",
    "permission-probe": "bun run scripts/permission-probe.ts",
    "oauth-pilot": "bun run scripts/oauth-pilot.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@opencode-ai/sdk": "1.19.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2"
  }
}
